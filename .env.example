# Copy this file to .env.local and fill in the values.
# On Vercel, add the same variables under Project → Settings → Environment Variables.

# ── Database (Supabase Postgres) ────────────────────────────────────────────
# Supabase dashboard → Connect → "Transaction pooler" (port 6543). Used by the app at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Supabase dashboard → Connect → "Session pooler" (port 5432). Used by migrations and the seed script.
DIRECT_DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Supabase Realtime (instant updates between phones) ──────────────────────
# Supabase dashboard → Project Settings → API Keys. Use the *publishable* key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ── Family passcode gate ────────────────────────────────────────────────────
# The one passcode everyone types once per device. Changing it signs every device out.
FAMILY_PASSCODE="choose-something-longer-than-4-digits"
# Random secret used to sign the device cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# ── Web push (phase 5) ──────────────────────────────────────────────────────
# Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# A contact address push services can reach you at.
VAPID_SUBJECT="mailto:you@example.com"

# ── Daily digest cron (phase 5) ─────────────────────────────────────────────
# Any long random string. Vercel sends it automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""
